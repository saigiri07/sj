class Solution {
    public int maxAreaOfIsland(int[][] grid) {
        int max=0;
        int count[]=new int[1];
        int m=grid.length;
        int n=grid[0].length;
        for(int i=0;i<m;i++){
            for(int j=0;j<n;j++){
                if(grid[i][j]==1){
                    count[0]=0;
                    convert(grid,i,j,count);
                    if(max<count[0])max=count[0];
                }
            }
        }
        return max;
    }
    //we are just keep tracking of every land we convert into water
    //return the max
    public void convert(int[][] grid,int i,int j,int count[]){
        if(i<0||j<0||i==grid.length||j==grid[0].length||grid[i][j]==0)
            return;
        grid[i][j]=0;
        count[0]++;
        convert(grid,i-1,j,count);
        convert(grid,i+1,j,count);
        convert(grid,i,j-1,count);
        convert(grid,i,j+1,count);

    }

}

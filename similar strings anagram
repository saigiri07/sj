class Solution {
    public int numSimilarGroups(String[] strs) {
        int n=strs.length;
        int[] uf=new int[n];
        int[] rank=new int[n];
        for(int i=0;i<n;i++){
            uf[i]=-1;
        }
            for(int i=0;i<n;i++){
                for(int j=i+1;j<n;j++){
                    int x=diff(strs[i],strs[j]);
                        int tp=find(i,uf);
                        int cp=find(j,uf);
                    if(x==2||x==0){
                        if(tp!=cp){
                            if(rank[tp]>=rank[cp]){
                                uf[cp]=tp;
                                    rank[tp]+=rank[cp];
                            }else {
                                    uf[tp] = cp;
                                    rank[cp]+=rank[tp];
                          }
                    }
                    }
                }
            }
        
        for(int i=0;i<n;i++)
        if(uf[i]!=-1)
        find(i,uf);
        Set<Integer> res=new HashSet<>();
        for(int i:uf){
            if(i!=-1)
            res.add(i);
        }
        return res.size();
         
    }
    public int find(int i,int[] uf){
        if(uf[i]==-1){
            uf[i]=i;
            return i;
        }
        if(uf[i]==i)return i;
        else{
            uf[i]=find(uf[i],uf);
            return uf[i];
        }
    }
    public int diff(String a,String b){
        int x=-1;
        int y=-1;
        int diff=0;
        for(int i=0;i<a.length();i++){
            boolean flag=a.charAt(i)!=b.charAt(i);
            if(flag&&x==-1){
                x=i;
                diff=1;
            }else if(flag&&y==-1){
                y=i;
                diff=2;
            }else if(flag)return 100;
        }
        return diff;
    }
}

class Solution {
   public int numEnclaves(int[][] grid) {
        int m=grid.length;
        int n=grid[0].length;
        int count=0;
        int[][] visited=new int[m][n];
        for(int i=0;i<m;i++){
             if(grid[i][0]==1)
            convert(grid,i,0);
             if(grid[i][n-1]==1)
            convert(grid,i,n-1);
        }
        for(int j=0;j<n;j++){
            if(grid[0][j]==1)
            convert(grid,0,j);
            if(grid[m-1][j]==1)
            convert(grid,m-1,j);
        }
        for(int i=0;i<m;i++){
            for(int j=0;j<n;j++){
                if(grid[i][j]==1)
                    count++;
            }
        }
        return count;

    }

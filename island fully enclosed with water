class Solution {
    public int closedIsland(int[][] grid) {
        int m=grid.length;
        int n=grid[0].length;

        for(int i=0;i<m;i++){
            if(grid[i][0]==0)
                convert(grid,i,0);
            if(grid[i][n-1]==0)
                convert(grid,i,n-1);
        }
        for(int j=0;j<n;j++){
            if(grid[0][j]==0)
                convert(grid,0,j);
            if(grid[m-1][j]==0)
                convert(grid,m-1,j);
        }
        int count=0;
        for(int i=1;i<m-1;i++){
            for(int j=1;j<n-1;j++){
                if(grid[i][j]==0){
                    count++;
                    convert(grid,i,j);
                }
            }
        }
        return count;
//we are doing basic dfs and converting every land into water thats on borders and ever land connected to it
//and also couting every island and converting it into water to ensure we arent re counting
// using basic dfs going in all directions up down left and right
        
    }
    public void convert(int[][] grid,int i,int j){
        if(i<0||j<0||i==grid.length||j==grid[0].length||grid[i][j]==1)
            return;
        grid[i][j]=1;
        convert(grid,i-1,j);
        convert(grid,i+1,j);
        convert(grid,i,j-1);
        convert(grid,i,j+1);
    }
}
